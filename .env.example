# ─────────────────────────────────────────────────────────────
# SABEQ — environment variables (template)
# Copy to .env for local development. NEVER commit real values.
# Full reference: docs/environments.md
# ─────────────────────────────────────────────────────────────

# ── shared ───────────────────────────────────────────────────
NODE_ENV=development                     # development | test | production
APP_ENV=local                            # local | staging | production

# ── apps/web (Next.js) ───────────────────────────────────────
WEB_PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1   # used by the browser
API_INTERNAL_URL=http://localhost:4000/api/v1      # used by server components (docker: http://api:4000/api/v1)

# ── apps/admin (Next.js) ─────────────────────────────────────
ADMIN_PORT=3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000   # admin links to public pages (e.g. a faculty page)

# ── apps/api (Express) ───────────────────────────────────────
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=debug                          # fatal | error | warn | info | debug | trace | silent
API_TRUST_PROXY=0                        # reverse proxies in front of the API (Docker: 1 — the Next.js rewrite)
API_RATE_LIMIT_WINDOW_MS=60000           # rate-limit window for /api/v1
API_RATE_LIMIT_MAX=300                   # requests per client IP per window
# Phase 21 — the visitor's real IP. The web and admin proxies send it to the API with this shared
# secret (32+ random characters, same value in web, admin and api; required in production):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_PROXY_SECRET=
# web / admin: the header your hosting platform sets to the visitor's IP (Vercel: x-real-ip).
# Leave empty locally — the API then uses the connection's address.
PROXY_CLIENT_IP_HEADER=
API_BODY_LIMIT=100kb                     # max JSON body size

# database — PostgreSQL (Phase 06). The POSTGRES_* values configure the local Docker container.
POSTGRES_USER=sabeq
POSTGRES_PASSWORD=sabeq
POSTGRES_DB=sabeq
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://sabeq:sabeq@localhost:5432/sabeq   # runtime (pooled on Neon: host with -pooler)
DATABASE_DIRECT_URL=postgresql://sabeq:sabeq@localhost:5432/sabeq   # migrations only (direct, no pooler)

# cache / queues / rate limit / OTP — Redis (Phase 02)
REDIS_URL=redis://localhost:6379
REDIS_HOST_PORT=6379

# auth (Phase 07) — phone + OTP, opaque session cookies.
# Key for hashing OTP codes, ≥ 32 chars. Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_OTP_SECRET=

# SMS — console (local/staging: the code is logged, and returned to the page locally). A real
# provider (local aggregator + Twilio Verify fallback) is required before production.
SMS_PROVIDER=console

# storage — S3-compatible private bucket for mentor documents (Phase 09).
# Local: the `storage` service in compose (versitygw). Hosted: Cloudflare R2 or AWS S3 — leave
# STORAGE_ENDPOINT empty for AWS, set it to the R2 account endpoint for R2.
# R2 (staging / production, set in the hosting secrets — never here):
#   STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   (without /bucket)
#   STORAGE_REGION=auto   STORAGE_BUCKET_PRIVATE=<bucket>   STORAGE_FORCE_PATH_STYLE=true
#   STORAGE_ACCESS_KEY_ID / STORAGE_SECRET_ACCESS_KEY = an R2 API token scoped to that bucket (Object Read & Write)
# Check a bucket and keys before deploying: pnpm storage:check
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET_PRIVATE=sabeq-private
STORAGE_ACCESS_KEY_ID=sabeq-local
STORAGE_SECRET_ACCESS_KEY=sabeq-local-secret
STORAGE_FORCE_PATH_STYLE=true
STORAGE_HOST_PORT=9000

# mentor documents are encrypted before upload (AES-256-GCM). id:base64(32 bytes), comma-separated;
# keep old keys listed after rotation. Generate a key per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DOCUMENTS_ENCRYPTION_KEYS=
DOCUMENTS_ENCRYPTION_ACTIVE_KEY=

# payments — Paymob (Phase 16)
# Payments (Phase 16). PAYMOB_MODE=fake gives a local test checkout (refused in production).
# With PAYMOB_MODE=paymob, from the Paymob dashboard → Developers → API keys / Payment integrations:
PAYMOB_MODE=fake
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_CARD=
PAYMOB_INTEGRATION_WALLET=
PAYMOB_INTEGRATION_KIOSK=
# The website origin people use; Paymob's callback and the return link go through it.
API_PUBLIC_WEB_URL=http://localhost:3000

# Email (Phase 19). EMAIL_PROVIDER=console logs emails instead of sending (refused in production).
# With EMAIL_PROVIDER=resend: an API key from resend.com, and EMAIL_FROM on a domain verified there.
EMAIL_PROVIDER=console
EMAIL_FROM="سابق <no-reply@localhost>"
EMAIL_API_KEY=

# Video sessions (Phase 17). VIDEO_PROVIDER=fake gives a local test room (refused in production).
# With VIDEO_PROVIDER=daily: the API key from the Daily dashboard → Developers.
VIDEO_PROVIDER=fake
DAILY_API_KEY=
