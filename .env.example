# ─────────────────────────────────────────────────────────────
# SABEQ — environment variables (template)
# Copy to .env for local development. NEVER commit real values.
# Full reference: docs/environments.md
# ─────────────────────────────────────────────────────────────

# ── shared ───────────────────────────────────────────────────
NODE_ENV=development                     # development | test | production
APP_ENV=local                            # local | staging | production

# ── apps/web (Next.js) ───────────────────────────────────────
WEB_PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1   # used by the browser
API_INTERNAL_URL=http://localhost:4000/api/v1      # used by server components (docker: http://api:4000/api/v1)

# ── apps/admin (Next.js) ─────────────────────────────────────
ADMIN_PORT=3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# ── apps/api (Express) ───────────────────────────────────────
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=debug                          # fatal | error | warn | info | debug | trace

# database — PostgreSQL (Phase 06). The POSTGRES_* values configure the local Docker container.
POSTGRES_USER=sabeq
POSTGRES_PASSWORD=sabeq
POSTGRES_DB=sabeq
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://sabeq:sabeq@localhost:5432/sabeq

# cache / queues / rate limit / OTP — Redis (Phase 02)
REDIS_URL=redis://localhost:6379
REDIS_HOST_PORT=6379

# auth (Phase 07) — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_ACCESS_TOKEN_SECRET=
AUTH_REFRESH_TOKEN_SECRET=
AUTH_COOKIE_DOMAIN=localhost
OTP_TTL_SECONDS=300

# SMS / OTP (Phase 07) — console | cequens | twilio
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=SABEQ

# storage — S3-compatible, private bucket for mentor documents (Phase 09)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET_PRIVATE=sabeq-private
STORAGE_BUCKET_PUBLIC=sabeq-public
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# payments — Paymob (Phase 16)
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_INTEGRATION_ID_KIOSK=

# email (Phase 19)
EMAIL_PROVIDER=console
EMAIL_FROM="سابق <no-reply@localhost>"
EMAIL_API_KEY=

# video sessions (Phase 17)
VIDEO_PROVIDER=
VIDEO_API_KEY=
