{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "SABEQ React package consumed as source (packages/ui)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": ["${configDir}/src"]
}
