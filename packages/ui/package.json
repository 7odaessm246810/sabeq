  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@sabeq/config": "workspace:*",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "react-dom": "catalog:",
    "@types/react-dom": "catalog:"
  }
}
