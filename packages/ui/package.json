{
  "name": "@sabeq/ui",
  "version": "0.0.0",
  "private": true,
  "description": "SABEQ design-system React components and stylesheet. Consumed as source by the Next.js apps (transpilePackages).",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/sabeq.css"
