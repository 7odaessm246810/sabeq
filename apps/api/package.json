{
  "name": "@sabeq/api",
  "version": "0.0.0",
  "private": true,
  "description": "SABEQ REST API (Express 5) — /api/v1, health checks, error envelope, security middleware.",
  "type": "module",
  "main": "dist/server.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:db": "prisma generate && tsx scripts/test-db.ts",
    "db:remote": "prisma generate && tsx scripts/remote-db.ts",
    "admin:create": "prisma generate && tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@sabeq/types": "workspace:*",
    "express": "catalog:",
    "cors": "catalog:",
    "express-rate-limit": "catalog:",
    "helmet": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "zod": "catalog:",
    "@prisma/client": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "pg": "catalog:",
    "ioredis": "catalog:",
    "@sabeq/utils": "workspace:*"
  },
  "devDependencies": {
    "@sabeq/config": "workspace:*",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "@types/cors": "catalog:",
    "@types/supertest": "catalog:",
    "pino-pretty": "catalog:",
    "supertest": "catalog:",
    "vitest": "catalog:",
    "prisma": "catalog:",
    "@types/pg": "catalog:"
  }
}
