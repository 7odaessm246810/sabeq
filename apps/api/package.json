{
  "name": "@sabeq/api",
  "version": "0.0.0",
  "private": true,
  "description": "SABEQ REST API (Express 5). Phase 02 skeleton: health endpoints only — the full foundation lands in Phase 05.",
  "type": "module",
  "main": "dist/server.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@sabeq/types": "workspace:*",
    "express": "catalog:"
  },
  "devDependencies": {
    "@sabeq/config": "workspace:*",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
