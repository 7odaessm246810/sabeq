{
  "name": "@sabeq/api",
  "version": "0.0.0",
  "private": true,
  "description": "SABEQ REST API (Express 5) — /api/v1, health checks, error envelope, security middleware.",
  "type": "module",
  "main": "dist/server.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@sabeq/types": "workspace:*",
    "express": "catalog:",
    "cors": "catalog:",
    "express-rate-limit": "catalog:",
    "helmet": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sabeq/config": "workspace:*",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "@types/cors": "catalog:",
    "@types/supertest": "catalog:",
    "pino-pretty": "catalog:",
    "supertest": "catalog:",
    "vitest": "catalog:"
  }
}
