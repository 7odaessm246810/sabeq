{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".env"],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*", "API_INTERNAL_URL", "APP_ENV"]
    },
    "dev": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "HOSTNAME",
        "TZ",
        "APP_ENV",
        "LOG_LEVEL",
        "API_*",
        "NEXT_PUBLIC_*",
        "CORS_ORIGINS",
        "DATABASE_*",
        "REDIS_*",
        "POSTGRES_*",
        "AUTH_*",
        "OTP_*",
        "SMS_*",
        "STORAGE_*",
        "DOCUMENTS_*",
        "PAYMOB_*",
        "EMAIL_*",
        "VIDEO_*",
        "WATCHPACK_*"
      ]
    },
    "lint": {
      "dependsOn": ["^build", "db:generate"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"]
    },
    "test": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
